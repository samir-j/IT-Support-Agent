# ═══════════════════════════════════════════════
#  IT Helpdesk AI — Full Environment Config
# ═══════════════════════════════════════════════

# ── Database ─────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/helpdesk
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/helpdesk

# ── LLM Provider ─────────────────────────────────
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── ChromaDB (local, no key needed) ──────────────
CHROMA_COLLECTION=helpdesk_kb

# ── Auth ──────────────────────────────────────────
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Escalation ────────────────────────────────────
ESCALATION_THRESHOLD=0.70

# ── Kafka (disabled by default) ──────────────────
KAFKA_ENABLED=False
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── Redis ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── App ───────────────────────────────────────────
DEBUG=False
APP_NAME=IT Helpdesk AI